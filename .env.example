# Copy this file to .env and adjust if your PostgreSQL credentials differ.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Optional Firebase web configuration for App Check and browser notifications.
NEXT_PUBLIC_FIREBASE_APP_CHECK_SITE_KEY=your_recaptcha_enterprise_site_key
NEXT_PUBLIC_FIREBASE_VAPID_KEY=your_web_push_vapid_key
