rules_version = '2';

// Assumed data model:
// users/{uid}/favorites/{recipeId}: recipeId (positive integer) and slug
// (lowercase recipe identifier, at most 80 characters).
// users/{uid}/devices/{tokenHash}: token (private Firebase Cloud Messaging
// registration token). Device documents are read by the owner and Admin SDK
// Cloud Functions only.
// No public profiles or user PII are stored in Firestore.

service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isDocOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function uidUnchanged() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == request.auth.uid;
    }

    function uidNotModified() {
      return !('uid' in request.resource.data) ||
        request.resource.data.uid == resource.data.uid;
    }

    function hasRequiredFields(data, fields) {
      return data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(data, fields) {
      return data.keys().hasOnly(fields);
    }

    function areImmutableFieldsUnchanged(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(fields);
    }

    function isValidFavorite(data, slugId) {
      return hasRequiredFields(data, ['recipeId', 'slug']) &&
        hasOnlyAllowedFields(data, ['recipeId', 'slug']) &&
        data.recipeId is int &&
        data.recipeId > 0 &&
        data.recipeId <= 100000 &&
        data.slug is string &&
        data.slug.size() > 0 &&
        data.slug.size() <= 80 &&
        data.slug.matches('^[a-z0-9]+(-[a-z0-9]+)*$') &&
        data.slug == slugId;
    }

    function isValidDevice(data) {
      return hasRequiredFields(data, ['token']) &&
        hasOnlyAllowedFields(data, ['token']) &&
        data.token is string &&
        data.token.size() > 0 &&
        data.token.size() <= 4096;
    }

    match /users/{userId}/favorites/{recipeId} {
      allow get, list: if isOwner(userId) && isDocOwner(userId);
      allow create: if isOwner(userId) &&
        isDocOwner(userId) &&
        uidUnchanged() &&
        isValidFavorite(request.resource.data, recipeId);
      allow update: if isOwner(userId) &&
        isDocOwner(userId) &&
        uidNotModified() &&
        isValidFavorite(request.resource.data, recipeId) &&
        areImmutableFieldsUnchanged(['recipeId', 'slug']);
      allow delete: if isOwner(userId) && isDocOwner(userId);
    }

    match /users/{userId}/devices/{tokenHash} {
      allow get, list: if isOwner(userId) &&
        isDocOwner(userId) &&
        tokenHash.matches('^[a-f0-9]{64}$');
      allow create, update: if isOwner(userId) &&
        isDocOwner(userId) &&
        tokenHash.matches('^[a-f0-9]{64}$') &&
        uidUnchanged() &&
        uidNotModified() &&
        isValidDevice(request.resource.data);
      allow delete: if isOwner(userId) &&
        isDocOwner(userId) &&
        tokenHash.matches('^[a-f0-9]{64}$');
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
